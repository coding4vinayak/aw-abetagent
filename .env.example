# AbetAgent - Autonomous AI agents
# Local Postgres via `docker compose up -d` (any Postgres 15+ works).
DATABASE_URL="postgresql://abetagent:abetagent@localhost:5432/abetagent"
REDIS_URL="redis://localhost:6379"

# Optional: any OpenAI-compatible endpoint for LLM replies.
# Without a key the built-in heuristic engine answers (deterministic, free).
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=12000
PRODUCT_NAME=AbetAgent
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3400

# Email delivery for verification + password reset. Unset, links are written to
# the server log and the UI says so instead of claiming a message was sent.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Abetworks <noreply@yourdomain.com>
